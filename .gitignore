__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Collected and downloaded data never goes in git. Anchored to the repo root: a bare
# "data/" also matches pcas/data/, which silently dropped the whole data package.
/data/
*.parquet
*.log

.env

# Generated training artefacts. Model weights and cached sample tensors are outputs, not
# source: the sample cache alone is 1.4 GB, which GitHub rightly refuses. Metrics and
# training histories (csv, json) are small and worth keeping.
artifacts/cache/
*.npz
*.pt
